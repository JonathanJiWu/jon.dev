---
/**
 * The fixed background: a still image first (fast, and all that no-WebGL, reduced-
 * motion and software-rendering visitors get), then the live canvas fades in over it
 * once the scene's first frame is drawn. Decorative: everything it shows is also in
 * the page's text.
 */
import { Picture } from 'astro:assets';

const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/poster.{jpg,png}', { eager: true });
const poster = Object.values(posters)[0]?.default;
---

<div class="scene" aria-hidden="true">
  {
    poster ? (
      <Picture
        src={poster}
        formats={['avif', 'webp']}
        widths={[960, 1440, 1920]}
        sizes="100vw"
        alt=""
        class="poster"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="poster poster-fallback" />
    )
  }
  <canvas data-scene-canvas></canvas>
  <div class="labels" data-scene-labels></div>
  <div class="scrim"></div>
</div>

<script>
  import '../scripts/boot';
</script>

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--bg);
  }

  .scene :global(picture),
  .scene :global(.poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
  }

  .poster-fallback {
    background:
      radial-gradient(120% 60% at 75% 70%, rgb(242 150 100 / 0.35), transparent 60%),
      linear-gradient(to bottom, #070b1c 0%, #18163a 55%, #3a2638 75%, #0c1018 100%);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  :global(html[data-scene='running']) canvas,
  :global(html[data-scene='paused']) canvas {
    opacity: 1;
  }

  .labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  :global(html[data-scene='running']) .labels {
    opacity: 1;
  }

  /* Legibility: darken toward the reading column, and more once past the hero. */
  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to right, rgb(5 8 15 / 0.82) 0%, rgb(5 8 15 / 0.55) 32%, rgb(5 8 15 / 0) 62%);
    transition: background-color 0.6s ease;
  }

  :global(html.past-hero) .scrim {
    background-color: rgb(5 8 15 / 0.25);
  }

  @media (max-width: 1080px) {
    .scrim {
      background: linear-gradient(to top, rgb(5 8 15 / 0.92) 0%, rgb(5 8 15 / 0.5) 45%, rgb(5 8 15 / 0.1) 75%);
    }
    :global(html.past-hero) .scrim {
      background-color: rgb(5 8 15 / 0.55);
    }
  }
</style>
