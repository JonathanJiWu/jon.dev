---
/**
 * A featured project: the whole card opens the case study; "Play" and "Download"
 * links sit above that and go straight to the thing itself.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, kind, period, stack, org, status, image, imageAlt, links } = project.data;
const href = url(`/projects/${project.id}/`);
const actions = links.filter((l) => l.kind === 'play' || l.kind === 'download');
---

<article class:list={['card', 'panel', { 'has-image': image }]}>
  <div class="text">
    <p class="kicker">{kind} · {period}{org && ` · ${org}`}</p>
    <h3><a href={href}>{title}</a></h3>
    {status && <p class="status">{status}</p>}
    <p class="summary">{summary}</p>
    <ul class="chips" aria-label="Stack">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
    <p class="actions">
      <span class="more" aria-hidden="true">Read the case study <span>→</span></span>
      {
        actions.map((l) => (
          <a class="ext" href={l.href}>
            {l.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </p>
  </div>
  {
    image && (
      <div class="shot">
        <Image src={image} alt={imageAlt ?? ''} widths={[400, 640, 960]} sizes="(min-width: 760px) 15rem, calc(100vw - 5rem)" />
      </div>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    transition:
      border-color 0.2s,
      transform 0.3s var(--ease-out);
  }

  @media (min-width: 760px) {
    .card.has-image {
      grid-template-columns: 1fr 15rem;
      align-items: start;
    }
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--magenta);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-2px);
    }
  }

  .text {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  h3 a {
    text-decoration: none;
  }

  /* The whole card is the case-study link; the heading carries the accessible name. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .status {
    justify-self: start;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--amber);
    border-radius: 999px;
    color: var(--amber);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .summary {
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .more {
    color: var(--magenta);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .more span {
    display: inline-block;
    transition: transform 0.2s var(--ease-out);
  }

  .card:hover .more span {
    transform: translateX(3px);
  }

  /* Direct links sit above the card-wide link. */
  .ext {
    position: relative;
    z-index: 1;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .ext:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .shot {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    aspect-ratio: 16 / 10;
    background: var(--bg-2);
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  @media (max-width: 759px) {
    .shot {
      order: -1;
    }
  }
</style>
