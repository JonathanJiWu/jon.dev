---
import '@fontsource/b612/400.css';
import '@fontsource/b612/700.css';
import '@fontsource/b612-mono/400.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '../styles/global.css';
import b612Bold from '@fontsource/b612/files/b612-latin-700-normal.woff2?url';
import plex from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile, skills } from '../data/profile';
import { url } from '../lib/url';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** The home page hosts the flight scene; other pages are for reading. */
  home?: boolean;
}

const { title, description = profile.description, type = 'website', home = false } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · Software engineer, real-time simulation`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og.jpg'), Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  url: new URL(url('/'), Astro.site).href,
  sameAs: [profile.links.linkedin, profile.links.github, profile.links.writing],
  knowsAbout: skills.find((s) => s.group === 'Engineering')?.items,
  address: { '@type': 'PostalAddress', addressRegion: 'MA', addressCountry: 'US' },
};
---

<!doctype html>
<html lang="en" data-scene="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#05080f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="preload" href={b612Bold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plex} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A four-engine transport on final approach at dusk, following a magenta glide path to a lit runway, with Jonathan Wu's name." />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {
      home && (
        <script is:inline>
          // Fly or Read, decided before first paint so the page doesn't flash. New
          // sessions fly; a choice is kept for the session; a link to a section reads.
          (function () {
            var d = document.documentElement;
            var q = new URLSearchParams(location.search);
            var view = 'fly';
            try {
              var v = sessionStorage.getItem('jw:view');
              if (v === 'read' || v === 'fly') view = v;
              if (sessionStorage.getItem('jw:welcome') === 'closed') d.classList.add('welcome-closed');
            } catch (e) {}
            if (location.hash.length > 1) view = 'read';
            if (q.get('view') === 'read' || q.get('view') === 'fly') view = q.get('view');
            if (q.has('poster') || (navigator.connection && navigator.connection.saveData)) view = 'read';
            d.dataset.view = view;
          })();
        </script>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <slot name="head" />
  </head>
  <body class:list={{ home }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader home={home} />
    <slot name="background" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
